<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vendor half of the retail ontology, written in RDF/XML.

  It shares the http://example.org/retail# namespace with retail.ttl, so
  go-to-definition, find-references and rename all work across the two files
  and across the two formats. Try F12 on retail:Product in retail.ttl.
-->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xml:base="http://example.org/retail">

  <owl:Class rdf:about="#Vendor">
    <rdfs:label xml:lang="en">Vendor</rdfs:label>
    <rdfs:comment>An organization that lists products for sale on the marketplace.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Organization"/>
  </owl:Class>

  <owl:Class rdf:about="#Brand">
    <rdfs:label xml:lang="en">Brand</rdfs:label>
    <rdfs:comment>A trade name products are marketed under.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Warehouse">
    <rdfs:label xml:lang="en">Warehouse</rdfs:label>
    <rdfs:comment>A location where a vendor holds stock.</rdfs:comment>
  </owl:Class>

  <!-- Object properties linking vendors back into the Turtle half -->

  <owl:ObjectProperty rdf:about="#soldBy">
    <rdfs:label xml:lang="en">sold by</rdfs:label>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range rdf:resource="#Vendor"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#underBrand">
    <rdfs:label xml:lang="en">under brand</rdfs:label>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range rdf:resource="#Brand"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#operatesWarehouse">
    <rdfs:label xml:lang="en">operates warehouse</rdfs:label>
    <rdfs:domain rdf:resource="#Vendor"/>
    <rdfs:range rdf:resource="#Warehouse"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#storedAt">
    <rdfs:label xml:lang="en">stored at</rdfs:label>
    <rdfs:domain rdf:resource="#InventoryItem"/>
    <rdfs:range rdf:resource="#Warehouse"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#warehouseAddress">
    <rdfs:label xml:lang="en">warehouse address</rdfs:label>
    <rdfs:domain rdf:resource="#Warehouse"/>
    <rdfs:range rdf:resource="#Address"/>
  </owl:ObjectProperty>

  <!-- Datatype properties -->

  <owl:DatatypeProperty rdf:about="#vendorId">
    <rdfs:label xml:lang="en">vendor id</rdfs:label>
    <rdfs:domain rdf:resource="#Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#taxId">
    <rdfs:label xml:lang="en">tax id</rdfs:label>
    <rdfs:domain rdf:resource="#Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#vendorRating">
    <rdfs:label xml:lang="en">vendor rating</rdfs:label>
    <rdfs:domain rdf:resource="#Vendor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#brandName">
    <rdfs:label xml:lang="en">brand name</rdfs:label>
    <rdfs:domain rdf:resource="#Brand"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#warehouseCode">
    <rdfs:label xml:lang="en">warehouse code</rdfs:label>
    <rdfs:domain rdf:resource="#Warehouse"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
