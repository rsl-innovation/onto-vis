{
  "comments": { "blockComment": ["<!--", "-->"] },
  "brackets": [["<", ">"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "<", "close": ">" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [["<", ">"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "([A-Za-z_][-A-Za-z0-9_.]*:[-A-Za-z0-9_.]*)|([A-Za-z_][-A-Za-z0-9_.]*)|(#[-A-Za-z0-9_.]+)",
  "indentationRules": {
    "increaseIndentPattern": "<(?!\\?|[^>]*/>)([-_.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*</\\1>)|<!--(?!.*-->)",
    "decreaseIndentPattern": "^\\s*(</[-_.A-Za-z0-9]+\\s*>|-->)"
  }
}
