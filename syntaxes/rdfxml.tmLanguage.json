{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RDF/XML",
  "scopeName": "text.xml.rdf",
  "patterns": [
    { "include": "#rdf-iri-attribute" },
    { "include": "text.xml" }
  ],
  "repository": {
    "rdf-iri-attribute": {
      "comment": "Scope the IRI-bearing RDF attributes so themes and semantic tokens can highlight the term itself, not just generic XML string content.",
      "match": "\\b(rdf:(?:about|resource|ID|datatype|nodeID|type|parseType))(\\s*=\\s*)([\"'])([^\"']*)(\\3)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.rdf.xml" },
        "2": { "name": "punctuation.separator.key-value.xml" },
        "3": { "name": "punctuation.definition.string.begin.xml" },
        "4": { "name": "string.quoted.other.iri.rdf.xml" },
        "5": { "name": "punctuation.definition.string.end.xml" }
      }
    }
  }
}
